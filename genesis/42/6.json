{"tier":"glm-5.2","verse":6,"ref":"genesis 42:6","book":"genesis","lang":"bho","chapter":42,"translation":"आ योसेफ ऊ पूरा धरती पर हाकिम रहलें, ऊ धरती के सभे लोगन के अनाज बेचेलें। योसेफ के भाई सभे आवल लोगन के बीचे, काहे कि कनान के धरती में अकाल पड़ल रहे। आ ऊ धरती के सभे लोगन के अनाज बेचेलें, आ योसेफ के भाई सभे आवलें आ ओकरा आगे मुँह धरती पर झुका के दण्डवत कइलें।","tokens":[{"surface":"ויוסף","gloss":"आ योसेफ"},{"surface":"הוא","gloss":"ऊ"},{"surface":"השליט","gloss":"हाकिम रहलें"},{"surface":"על","gloss":"पर"},{"surface":"הארץ","gloss":"पूरा धरती"},{"surface":"הוא","gloss":"ऊ"},{"surface":"המשביר","gloss":"अनाज बेचेलें"},{"surface":"לכל","gloss":"सभे लोगन के"},{"surface":"עם","gloss":"लोगन के"},{"surface":"הארץ","gloss":"धरती के"},{"surface":"ויבאו","gloss":"आवलें"},{"surface":"אחי","gloss":"के भाई सभे"},{"surface":"יוסף","gloss":"योसेफ"},{"surface":"וישתחוו","gloss":"दण्डवत कइलें"},{"surface":"לו","gloss":"ओकरा आगे"},{"surface":"אפים","gloss":"मुँह"},{"surface":"ארצה","gloss":"धरती पर झुका के"}],"timestamp":"2026-09-11T17:32:55.842020992Z","model":"glm-5.3"}