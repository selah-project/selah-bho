{"tier":"glm-5.2","verse":55,"ref":"numbers 33:55","book":"numbers","lang":"bho","chapter":33,"translation":"आ अगर रउआ सभे ⟨את⟩ ओ धरती के बासिन्दा लोग के आपन आगे से नाहीं हटाब, तऽ भई कि जे लोग रउआ उन में से छोड़ब, ऊ रउआ के आँखि में काँड़ा आ काँखि में काँटा बनी जाई, आ ऊ ⟨את⟩ रउआ के ओ धरती पर, जेहिजे रउआ बसल बानी, परेशान करिहें।","tokens":[{"surface":"ואם","gloss":"आ अगर"},{"surface":"לא","gloss":"नाहीं"},{"surface":"תורישו","gloss":"हटाब"},{"surface":"את","gloss":"⟨את⟩","marks":"बासिन्दा लोग"},{"surface":"ישבי","gloss":"बासिन्दा लोग"},{"surface":"הארץ","gloss":"धरती के"},{"surface":"מפניכם","gloss":"आपन आगे से"},{"surface":"והיה","gloss":"तऽ भई"},{"surface":"אשר","gloss":"जे"},{"surface":"תותירו","gloss":"छोड़ब"},{"surface":"מהם","gloss":"उन में से"},{"surface":"לשכים","gloss":"काँड़ा"},{"surface":"בעיניכם","gloss":"रउआ के आँखि में"},{"surface":"ולצנינם","gloss":"आ काँटा"},{"surface":"בצדיכם","gloss":"रउआ के काँखि में"},{"surface":"וצררו","gloss":"परेशान करिहें"},{"surface":"אתכם","gloss":"⟨את⟩","marks":"रउआ के"},{"surface":"על","gloss":"ऊपर"},{"surface":"הארץ","gloss":"धरती"},{"surface":"אשר","gloss":"जेहिजे"},{"surface":"אתם","gloss":"रउआ"},{"surface":"ישבים","gloss":"बसल"},{"surface":"בה","gloss":"ओहिजे"}],"timestamp":"2026-09-11T18:28:28.214248635Z","model":"glm-5.3"}